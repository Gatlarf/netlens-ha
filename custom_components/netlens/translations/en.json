{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Netlens",
        "description": "Enter the address of your Netlens (for example http://192.168.0.189:8080) and an API token (create one in Netlens under Settings > Users & tokens; a read-only viewer user is enough). Older installs can use their NETLENS_TOKEN.",
        "data": {
          "url": "Netlens URL",
          "token": "Access token",
          "verify_ssl": "Verify the TLS certificate (only matters for https)"
        }
      },
      "reconfigure": {
        "title": "Change the Netlens connection",
        "description": "Change the address or the token. Leave the token empty to keep the current one. Your entities, names and automations stay as they are.",
        "data": {
          "url": "Netlens URL",
          "token": "New access token (empty = keep the current one)",
          "verify_ssl": "Verify the TLS certificate (only matters for https)"
        }
      },
      "reauth_confirm": {
        "title": "Netlens needs a new token",
        "description": "The token for {url} was refused. Create a new API token in Netlens (Settings > Users & tokens) and enter it here.",
        "data": {
          "token": "Access token"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach Netlens at that address.",
      "invalid_auth": "Netlens refused the token.",
      "invalid_url": "That is not a valid address.",
      "unsupported": "This Netlens is too old, or newer than this integration understands. Update Netlens (it needs the statistics API) or the integration."
    },
    "abort": {
      "already_configured": "This Netlens is already set up.",
      "reauth_successful": "The new token works.",
      "reconfigure_successful": "The connection was updated."
    }
